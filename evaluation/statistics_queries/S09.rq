SELECT (COUNT(DISTINCT ?term) AS ?count) WHERE { { SELECT DISTINCT ?s ?p ?o WHERE {
VALUES ?g { <http://www.ics.forth.gr/isl/uniStats> <http://www.ics.forth.gr/isl/uniStats/personnel> <http://www.ics.forth.gr/isl/uniStats_departments> }
GRAPH ?g { ?s ?p ?o }
} } { BIND(?s AS ?term) } UNION { BIND(?o AS ?term) } FILTER(isBlank(?term)) }
