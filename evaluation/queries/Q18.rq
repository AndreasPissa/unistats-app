PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX dim: <http://www.ics.forth.gr/uniStats/dimension/>
PREFIX res: <http://www.ics.forth.gr/uniStats/resource/>
PREFIX uni: <http://www.ics.forth.gr/uniStats/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX staffCat: <http://www.ics.forth.gr/uniStats/resource/staffCategory/>
SELECT ?academicYear ?department ?totalStudents ?depStaff
       (ROUND((xsd:double(?totalStudents)/xsd:double(?depStaff))*100.0)/100.0 AS ?studentsPerDEP)
FROM <http://www.ics.forth.gr/isl/uniStats>
FROM <http://www.ics.forth.gr/isl/uniStats_departments>
FROM <http://www.ics.forth.gr/isl/uniStats/personnel>
WHERE {
  {
    SELECT ?academicYear ?department (SUM(?studentCount) AS ?totalStudents)
    WHERE {
      ?studentObs qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/studentsByBirthYearStudyYearDataset> ;
                  dim:academicYear ?academicYear ; dim:program ?program ; dim:count ?studentCount .
      ?department uni:hasUniversityProgram ?program .
    } GROUP BY ?academicYear ?department
  }
  {
    SELECT ?academicYear ?department (SUM(?count) AS ?depStaff)
    WHERE {
      ?staffObs qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/teachingStaffByCategoryDataset> ;
                dim:academicYear ?academicYear ; dim:department ?department ;
                dim:staffCategory ?category ; dim:count ?count .
      ?category skos:broader staffCat:RegularTeachingResearchStaff .
    } GROUP BY ?academicYear ?department
  }
  # VALUES ?academicYear { res:AY2023_2024 }
  FILTER(?depStaff>0)
}
ORDER BY ?academicYear DESC(?studentsPerDEP)
