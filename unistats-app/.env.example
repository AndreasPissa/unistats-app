# Copy this file to .env. Backend loads it automatically; restart after changes.
# Existing process environment variables take precedence. Never commit .env.
UNISTATS_ENDPOINT=http://93.115.20.167:8890/sparql
# auto = live database with explicitly labelled local RDF fallback
# live = require the remote database; snapshot = use local RDF only
UNISTATS_SOURCE=auto
# Hosted AI (OpenAI-compatible Chat Completions). No local model is needed.
# Leave these three values blank until you choose a provider.
UNISTATS_AI_API_KEY=
# Provider's HTTPS API base, often ending in /v1, WITHOUT /chat/completions.
UNISTATS_AI_BASE_URL=
UNISTATS_AI_MODEL=
UNISTATS_AI_ENABLED=true
# json_schema requires strict structured outputs; json_object supports JSON-only models.
UNISTATS_AI_RESPONSE_FORMAT=json_schema
# Some compatible providers require max_tokens instead of max_completion_tokens.
UNISTATS_AI_TOKEN_PARAMETER=max_completion_tokens
UNISTATS_AI_MAX_TOKENS=2048
# Total planning deadline, including at most one correction (5-300 seconds).
UNISTATS_AI_TIMEOUT=90
