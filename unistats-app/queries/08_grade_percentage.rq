PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX dim: <http://www.ics.forth.gr/uniStats/dimension/>
PREFIX res: <http://www.ics.forth.gr/uniStats/resource/>
PREFIX uni: <http://www.ics.forth.gr/uniStats/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX staffCat: <http://www.ics.forth.gr/uniStats/resource/staffCategory/>
SELECT ?academicYear ?program ?degreeGrade ?graduates ?totalGraduates
       (ROUND((?graduates * 10000.0) / ?totalGraduates)/100.0 AS ?gradePercentage)
FROM <http://www.ics.forth.gr/isl/uniStats>
FROM <http://www.ics.forth.gr/isl/uniStats_departments>
FROM <http://www.ics.forth.gr/isl/uniStats/personnel>
WHERE {
  {
    SELECT ?academicYear ?program ?degreeGrade (SUM(?count) AS ?graduates)
    WHERE {
      ?o qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/graduatesByDegreeGradeDataset> ;
         dim:academicYear ?academicYear ; dim:program ?program ;
         dim:degreeGrade ?degreeGrade ; dim:count ?count .
    }
    GROUP BY ?academicYear ?program ?degreeGrade
  }
  {
    SELECT ?academicYear ?program (SUM(?count) AS ?totalGraduates)
    WHERE {
      ?o2 qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/graduatesByDegreeGradeDataset> ;
          dim:academicYear ?academicYear ; dim:program ?program ; dim:count ?count .
    }
    GROUP BY ?academicYear ?program
  }
  # VALUES ?academicYear { res:AY2023_2024 }
  # VALUES ?degreeGrade { res:Excellent }
}
ORDER BY ?academicYear ?program DESC(?gradePercentage)
