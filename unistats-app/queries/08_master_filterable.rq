PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX dim: <http://www.ics.forth.gr/uniStats/dimension/>
PREFIX res: <http://www.ics.forth.gr/uniStats/resource/>
PREFIX uni: <http://www.ics.forth.gr/uniStats/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX staffCat: <http://www.ics.forth.gr/uniStats/resource/staffCategory/>
SELECT ?academicYear ?university ?department ?program ?city ?region ?gender ?degreeGrade
       (SUM(?count) AS ?graduates)
FROM <http://www.ics.forth.gr/isl/uniStats>
FROM <http://www.ics.forth.gr/isl/uniStats_departments>
FROM <http://www.ics.forth.gr/isl/uniStats/personnel>
WHERE {
  ?obs qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/graduatesByDegreeGradeDataset> ;
       dim:academicYear ?academicYear ; dim:program ?program ;
       dim:gender ?gender ; dim:degreeGrade ?degreeGrade ; dim:count ?count .
  ?department uni:hasUniversityProgram ?program .
  OPTIONAL { ?school uni:hasDepartment ?department . ?university uni:hasSchool ?school . }
  OPTIONAL { ?department uni:hasCity ?city . OPTIONAL { ?city uni:hasRegion ?region } }
  # VALUES ?academicYear { res:AY2023_2024 }
  # VALUES ?gender { res:Female }
  # VALUES ?degreeGrade { res:Excellent }
  # VALUES ?department { <http://www.csd.uoc.gr/> }
  # VALUES ?university { <UNIVERSITY_URI> }
}
GROUP BY ?academicYear ?university ?department ?program ?city ?region ?gender ?degreeGrade
ORDER BY ?academicYear ?program ?gender ?degreeGrade
