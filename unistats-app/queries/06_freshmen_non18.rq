PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX dim: <http://www.ics.forth.gr/uniStats/dimension/>
PREFIX res: <http://www.ics.forth.gr/uniStats/resource/>
PREFIX uni: <http://www.ics.forth.gr/uniStats/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX staffCat: <http://www.ics.forth.gr/uniStats/resource/staffCategory/>
SELECT ?academicYear ?program
       (SUM(IF(?entryAge = 18, ?count, 0)) AS ?age18Freshmen)
       (SUM(IF(?entryAge != 18, ?count, 0)) AS ?non18Freshmen)
       (SUM(?count) AS ?freshmenWithExactBirthYear)
       (ROUND((SUM(IF(?entryAge != 18, ?count, 0.0))/SUM(?count))*10000.0)/100.0 AS ?non18Percentage)
FROM <http://www.ics.forth.gr/isl/uniStats>
FROM <http://www.ics.forth.gr/isl/uniStats_departments>
FROM <http://www.ics.forth.gr/isl/uniStats/personnel>
WHERE {
  ?obs qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/studentsByBirthYearStudyYearDataset> ;
       dim:academicYear ?academicYear ; dim:program ?program ; dim:studyYear res:StudyYear1 ;
       dim:birthYear ?birthYear ; dim:count ?count .
  FILTER(datatype(?birthYear)=xsd:gYear)
  BIND(xsd:integer(SUBSTR(STR(?academicYear), STRLEN(STR(?academicYear))-8, 4)) AS ?entryYear)
  BIND(?entryYear - xsd:integer(STR(?birthYear)) AS ?entryAge)
  # VALUES ?academicYear { res:AY2023_2024 }
}
GROUP BY ?academicYear ?program
HAVING(SUM(?count)>0)
ORDER BY ?academicYear DESC(?non18Percentage)
