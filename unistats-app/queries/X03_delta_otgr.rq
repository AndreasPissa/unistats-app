PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX dim: <http://www.ics.forth.gr/uniStats/dimension/>
PREFIX res: <http://www.ics.forth.gr/uniStats/resource/>
PREFIX uni: <http://www.ics.forth.gr/uniStats/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX staffCat: <http://www.ics.forth.gr/uniStats/resource/staffCategory/>
SELECT ?program ?femaleSOTGR ?maleSOTGR
       (ROUND((?femaleSOTGR - ?maleSOTGR)*100.0)/100.0 AS ?deltaOTGR)
FROM <http://www.ics.forth.gr/isl/uniStats>
FROM <http://www.ics.forth.gr/isl/uniStats_departments>
FROM <http://www.ics.forth.gr/isl/uniStats/personnel>
WHERE {
  ?program uni:officialStudyDurationYears "4"^^xsd:integer .
  {
    SELECT ?program (ROUND((xsd:double(?fg)/xsd:double(?fe))*10000.0)/100.0 AS ?femaleSOTGR)
    WHERE {
      { SELECT ?program (SUM(?c) AS ?fe) WHERE {
           ?o qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/studentsByBirthYearStudyYearDataset> ;
              dim:academicYear res:AY2020_2021 ; dim:program ?program ; dim:studyYear res:StudyYear1 ;
              dim:birthYear "2002"^^xsd:gYear ; dim:gender res:Female ; dim:count ?c .
         } GROUP BY ?program }
      { SELECT ?program (SUM(?c) AS ?fg) WHERE {
           ?o qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/graduatesByBirthYearDataset> ;
              dim:academicYear res:AY2023_2024 ; dim:program ?program ;
              dim:birthYear "2002"^^xsd:gYear ; dim:gender res:Female ; dim:count ?c .
         } GROUP BY ?program }
      FILTER(?fe>0)
    }
  }
  {
    SELECT ?program (ROUND((xsd:double(?mg)/xsd:double(?me))*10000.0)/100.0 AS ?maleSOTGR)
    WHERE {
      { SELECT ?program (SUM(?c) AS ?me) WHERE {
           ?o qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/studentsByBirthYearStudyYearDataset> ;
              dim:academicYear res:AY2020_2021 ; dim:program ?program ; dim:studyYear res:StudyYear1 ;
              dim:birthYear "2002"^^xsd:gYear ; dim:gender res:Male ; dim:count ?c .
         } GROUP BY ?program }
      { SELECT ?program (SUM(?c) AS ?mg) WHERE {
           ?o qb:dataSet <http://www.ics.forth.gr/uniStats/dataset/graduatesByBirthYearDataset> ;
              dim:academicYear res:AY2023_2024 ; dim:program ?program ;
              dim:birthYear "2002"^^xsd:gYear ; dim:gender res:Male ; dim:count ?c .
         } GROUP BY ?program }
      FILTER(?me>0)
    }
  }
}
ORDER BY DESC(?deltaOTGR)
