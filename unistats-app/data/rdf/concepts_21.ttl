    rdfs:label "Auxiliary Teaching Staff"@en ;
    skos:broader staffCat:AllTeachingStaff .

staffCat:CuratorWithPhD a skos:Concept ;
    skos:prefLabel "Επιμελητές με PhD"@el ;
    rdfs:label "Curators with PhD"@en ;
    skos:broader staffCat:AuxiliaryTeachingStaff .
	
staffCat:CuratorWithoutPhD a skos:Concept ;
    skos:prefLabel "Επιμελητές χωρίς PhD"@el ;
    rdfs:label "Curators withoudPhD"@en ;
    skos:broader staffCat:AuxiliaryTeachingStaff .

staffCat:AssistantWithPhD a skos:Concept ;
    skos:prefLabel "Βοηθοί με PhD"@el ;
    rdfs:label "Teaching Assistants with PhD"@en ;
    skos:broader staffCat:AuxiliaryTeachingStaff .

staffCat:AssistantWithoutPhD a skos:Concept ;
    skos:prefLabel "Βοηθοί χωρίς PhD"@el ;
    rdfs:label "Teaching Assistants without PhD"@en ;
    skos:broader staffCat:AuxiliaryTeachingStaff .

staffCat:ScientificAssociateWithPhD a skos:Concept ;
    skos:prefLabel "Επιστημονικοί Συνεργάτες με PhD"@el ;
    rdfs:label "Scientific Associates with PhD"@en ;
    skos:broader staffCat:AuxiliaryTeachingStaff .

staffCat:ScientificAssociateWithoutPhD a skos:Concept ;
    skos:prefLabel "Επιστημονικοί Συνεργάτες χωρίς PhD"@el ;
    rdfs:label "Scientific Associates without PhD"@en ;
    skos:broader staffCat:AuxiliaryTeachingStaff .

# ============================================================
# 7. ΛΟΙΠΕΣ ΠΕΡΙΠΤΩΣΕΙΣ ΔΙΔΑΣΚΟΝΤΩΝ
# ============================================================

staffCat:OtherTeachingStaff a skos:Concept ;
    skos:prefLabel "Λοιπές περιπτώσεις διδασκόντων (Ν. 1566 κλπ)"@el ;
    rdfs:label "Other Teaching Staff Categories"@en ;
    skos:broader staffCat:AllTeachingStaff .